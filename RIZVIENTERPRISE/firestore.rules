rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(r) { return signedIn() && request.auth.token.role == r; }
    function manager() { return signedIn() && request.auth.token.role in ['admin','director']; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /rizvi_sync/{docId} {
      allow read: if signedIn();
      allow create, update: if manager();
      allow delete: if role('admin');
    }

    match /rizvi_tasks/{docId} {
      allow read: if signedIn();
      allow create, update: if manager();
      allow delete: if role('admin');
    }

    match /auditLogs/{docId} {
      allow read: if manager();
      allow create: if signedIn();
      allow update, delete: if role('admin');
    }

    match /{document=**} { allow read, write: if false; }
  }
}
